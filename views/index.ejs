<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= data.name %> — <%= data.role %></title>
  <meta name="description" content="<%= data.tagline %>" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body data-bs-spy="scroll" data-bs-target="#navbar" data-bs-offset="80">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="navbar">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#hero"></a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navMenu">
        <ul class="navbar-nav gap-1 align-items-center">
          <li class="nav-item"><a class="nav-link" href="#hero">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="#about">About Me</a></li>
          <li class="nav-item"><a class="nav-link" href="#projects">My Projects</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact Me</a></li>
          <li class="nav-item ms-lg-3">
            <a class="btn-outline-accent" href="/resume.pdf" download>Resume</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ==================== HERO ==================== -->
  <section id="hero" class="hero-section">
    <div class="container">
      <div class="row align-items-center g-5">

        <!-- Left: text -->
        <div class="col-lg-6">
          <p class="hero-greeting">Hi, I'm</p>
          <h1 class="hero-name"><%= data.name %></h1>
          <p class="hero-role" id="heroRole"></p>
          <p class="hero-desc"><%= data.tagline %></p>

          <div class="hero-stack">
            <% data.stack.forEach(s => { %>
              <span class="stack-badge"><%= s %></span>
            <% }) %>
          </div>

          <div class="hero-status">
            <span class="status-dot"></span>
            <span><%= data.status %></span>
          </div>

          <div class="hero-cta">
            <a href="#projects" class="btn-gradient"><i class="bi bi-grid-3x3-gap-fill"></i> View My Work</a>
            <a href="#contact" class="btn-ghost"><i class="bi bi-chat-dots"></i> Get In Touch</a>
            <a href="/resume.pdf" download class="btn-resume"><i class="bi bi-download"></i> Resume</a>
          </div>
        </div>

        <!-- Right: illustration + stats -->
        <div class="col-lg-6">
          <div class="hero-illustration">
            <svg width="100%" viewBox="0 0 680 380" role="img" aria-label="Creative advertising illustration">
              <defs>
                <style>
                  .big-word { font-family: 'Inter', sans-serif; font-weight: 900; fill: rgba(255,255,255,0.04); font-size: 118px; letter-spacing: -4px; }
                  .kw  { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 12px; fill: #00d4ff; letter-spacing: 1.5px; }
                  .kw2 { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 12px; fill: #b0a8ff; letter-spacing: 1.5px; }
                  .ic  { fill: rgba(10,10,26,0.95); stroke: rgba(0,212,255,0.3); stroke-width: 1; }
                  .ip  { fill: rgba(10,10,26,0.95); stroke: rgba(124,106,255,0.3); stroke-width: 1; }
                  .dl  { stroke: rgba(0,212,255,0.18); stroke-width: 1; stroke-dasharray: 3 5; fill: none; }
                </style>
              </defs>

              <!-- Background big word -->
              <text x="340" y="242" text-anchor="middle" class="big-word">CREATIVE</text>

              <!-- Particles -->
              <circle cx="80" cy="58" r="2.5" fill="rgba(0,212,255,0.35)"/>
              <circle cx="600" cy="75" r="2" fill="rgba(124,106,255,0.4)"/>
              <circle cx="642" cy="198" r="3" fill="rgba(0,212,255,0.22)"/>
              <circle cx="48" cy="278" r="2" fill="rgba(124,106,255,0.35)"/>
              <circle cx="340" cy="38" r="2.5" fill="rgba(0,212,255,0.28)"/>
              <circle cx="178" cy="352" r="2" fill="rgba(124,106,255,0.3)"/>
              <circle cx="512" cy="342" r="2.5" fill="rgba(0,212,255,0.28)"/>
              <circle cx="422" cy="78" r="2" fill="rgba(124,106,255,0.22)"/>

              <!-- Connector dashed lines -->
              <line x1="148" y1="102" x2="215" y2="162" class="dl"/>
              <line x1="534" y1="98" x2="468" y2="158" class="dl"/>
              <line x1="158" y1="265" x2="228" y2="230" class="dl"/>
              <line x1="522" y1="268" x2="454" y2="230" class="dl"/>
              <line x1="340" y1="70" x2="340" y2="138" class="dl"/>
              <line x1="340" y1="232" x2="340" y2="250" class="dl"/>

              <!-- Orbital rings -->
              <ellipse cx="340" cy="196" rx="196" ry="82" fill="none" stroke="rgba(0,212,255,0.05)" stroke-width="1.5"/>
              <ellipse cx="340" cy="196" rx="222" ry="108" fill="none" stroke="rgba(124,106,255,0.04)" stroke-width="1"/>

              <!-- Badge: SOCIAL -->
              <rect x="50" y="50" width="92" height="28" rx="6" class="ic"/>
              <circle cx="65" cy="64" r="5" fill="rgba(0,212,255,0.12)" stroke="#00d4ff" stroke-width="1"/>
              <text x="77" y="68" class="kw">SOCIAL</text>

              <!-- Badge: MARKETING -->
              <rect x="265" y="22" width="150" height="32" rx="6" class="ip"/>
              <rect x="275" y="32" width="13" height="12" rx="3" fill="rgba(124,106,255,0.18)" stroke="#7c6aff" stroke-width="1"/>
              <text x="296" y="42" class="kw2">MARKETING</text>

              <!-- Badge: DIGITAL -->
              <rect x="538" y="50" width="92" height="28" rx="6" class="ip"/>
              <circle cx="553" cy="64" r="5" fill="rgba(124,106,255,0.12)" stroke="#7c6aff" stroke-width="1"/>
              <text x="565" y="68" class="kw2">DIGITAL</text>

              <!-- Badge: SEO -->
              <rect x="36" y="238" width="74" height="28" rx="6" class="ic"/>
              <rect x="48" y="248" width="11" height="9" rx="2" fill="rgba(0,212,255,0.12)" stroke="#00d4ff" stroke-width="1"/>
              <text x="66" y="257" class="kw">SEO</text>

              <!-- Badge: BRANDING -->
              <rect x="255" y="250" width="170" height="32" rx="6" class="ip"/>
              <rect x="265" y="260" width="13" height="12" rx="3" fill="rgba(0,212,255,0.12)" stroke="#00d4ff" stroke-width="1"/>
              <text x="286" y="270" class="kw">BRANDING</text>

              <!-- Badge: MEDIA -->
              <rect x="570" y="238" width="74" height="28" rx="6" class="ic"/>
              <circle cx="582" cy="252" r="5" fill="rgba(0,212,255,0.1)" stroke="#00d4ff" stroke-width="1"/>
              <text x="594" y="256" class="kw">MEDIA</text>

              <!-- Badge: AI TOOLS -->
              <rect x="84" y="155" width="106" height="30" rx="6" class="ip"/>
              <rect x="94" y="163" width="13" height="13" rx="6" fill="rgba(124,106,255,0.18)" stroke="#7c6aff" stroke-width="1"/>
              <text x="115" y="173" class="kw2">AI TOOLS</text>

              <!-- Badge: VISUAL -->
              <rect x="490" y="155" width="106" height="30" rx="6" class="ic"/>
              <rect x="500" y="163" width="13" height="13" rx="3" fill="rgba(0,212,255,0.12)" stroke="#00d4ff" stroke-width="1"/>
              <text x="521" y="173" class="kw">VISUAL</text>

              <!-- Badge: STRATEGY -->
              <rect x="50" y="306" width="112" height="28" rx="6" class="ip"/>
              <circle cx="64" cy="320" r="5" fill="rgba(124,106,255,0.12)" stroke="#7c6aff" stroke-width="1"/>
              <text x="76" y="324" class="kw2">STRATEGY</text>

              <!-- Badge: CONTENT -->
              <rect x="518" y="306" width="112" height="28" rx="6" class="ic"/>
              <circle cx="532" cy="320" r="5" fill="rgba(0,212,255,0.1)" stroke="#00d4ff" stroke-width="1"/>
              <text x="544" y="324" class="kw">CONTENT</text>

              <!-- Laptop icon (center) -->
              <rect x="316" y="156" width="48" height="30" rx="3" fill="rgba(10,10,26,0.95)" stroke="rgba(0,212,255,0.28)" stroke-width="1"/>
              <rect x="320" y="160" width="40" height="22" rx="2" fill="rgba(0,212,255,0.05)"/>
              <line x1="310" y1="186" x2="370" y2="186" stroke="rgba(0,212,255,0.28)" stroke-width="1"/>
              <rect x="328" y="186" width="24" height="3" rx="1.5" fill="rgba(0,212,255,0.18)"/>
              <line x1="324" y1="165" x2="356" y2="165" stroke="rgba(0,212,255,0.4)" stroke-width="1"/>
              <line x1="324" y1="169" x2="350" y2="169" stroke="rgba(124,106,255,0.4)" stroke-width="1"/>
              <line x1="324" y1="173" x2="354" y2="173" stroke="rgba(0,212,255,0.3)" stroke-width="1"/>
              <line x1="324" y1="177" x2="346" y2="177" stroke="rgba(124,106,255,0.3)" stroke-width="1"/>

              <!-- Megaphone (left) -->
              <polygon points="146,128 146,148 158,148 170,156 170,120 158,128" fill="rgba(0,212,255,0.08)" stroke="#00d4ff" stroke-width="1" stroke-linejoin="round"/>
              <line x1="148" y1="150" x2="148" y2="160" stroke="#00d4ff" stroke-width="1" opacity="0.45"/>
              <line x1="154" y1="150" x2="154" y2="162" stroke="#00d4ff" stroke-width="1" opacity="0.45"/>

              <!-- Target (right) -->
              <circle cx="522" cy="136" r="13" fill="rgba(124,106,255,0.06)" stroke="rgba(124,106,255,0.4)" stroke-width="1"/>
              <circle cx="522" cy="136" r="8" fill="rgba(124,106,255,0.08)" stroke="rgba(124,106,255,0.5)" stroke-width="1"/>
              <circle cx="522" cy="136" r="3" fill="rgba(124,106,255,0.5)"/>

              <!-- Left figure -->
              <circle cx="200" cy="192" r="7" fill="rgba(0,212,255,0.12)" stroke="#00d4ff" stroke-width="1"/>
              <line x1="200" y1="199" x2="200" y2="220" stroke="#00d4ff" stroke-width="1" opacity="0.4"/>
              <line x1="192" y1="207" x2="208" y2="207" stroke="#00d4ff" stroke-width="1" opacity="0.4"/>
              <line x1="200" y1="220" x2="194" y2="232" stroke="#00d4ff" stroke-width="1" opacity="0.4"/>
              <line x1="200" y1="220" x2="206" y2="232" stroke="#00d4ff" stroke-width="1" opacity="0.4"/>

              <!-- Right figure -->
              <circle cx="480" cy="192" r="7" fill="rgba(124,106,255,0.12)" stroke="#7c6aff" stroke-width="1"/>
              <line x1="480" y1="199" x2="480" y2="220" stroke="#7c6aff" stroke-width="1" opacity="0.4"/>
              <line x1="472" y1="207" x2="488" y2="207" stroke="#7c6aff" stroke-width="1" opacity="0.4"/>
              <line x1="480" y1="220" x2="474" y2="232" stroke="#7c6aff" stroke-width="1" opacity="0.4"/>
              <line x1="480" y1="220" x2="486" y2="232" stroke="#7c6aff" stroke-width="1" opacity="0.4"/>
            </svg>
          </div>

          <!-- Stat cards -->
          <div class="stats-row">
            <% data.stats.forEach(stat => { %>
            <div class="stat-card">
              <span class="stat-value"><%= stat.value %></span>
              <span class="stat-label"><%= stat.label %></span>
            </div>
            <% }) %>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section id="about" class="section-padding section-alt">
    <div class="container">
      <p class="section-eyebrow text-center">GET TO KNOW ME</p>
      <h2 class="section-title text-center">About <span class="accent">Me</span></h2>
      <p class="section-subtitle text-center mb-5">My background, skills &amp; experience</p>

      <div class="row g-4">

        <!-- Left: Who I am + skill boxes -->
        <div class="col-lg-5">
          <!-- Tab switcher for left panel -->
          <ul class="nav about-tabs mb-0" id="aboutTabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-whoiam">Who I Am</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-experience">Experience</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-education">Education</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-awards">Awards</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-certs">Certifications</button></li>
          </ul>

          <div class="tab-content about-tab-content">

            <!-- WHO I AM -->
            <div class="tab-pane fade show active" id="tab-whoiam">
              <div class="skill-box who-i-am">
                <div class="who-label"><i class="bi bi-person-circle"></i> WHO I AM</div>
                <% data.about.split('\n\n').forEach(para => { %>
                  <p><%= para %></p>
                <% }) %>
              </div>

              <div class="skill-box">
                <div class="skill-box-label">AI &amp; Creative</div>
                <div class="skill-tags">
                  <% ['AI Content Creation','AI Filmmaking','Visual Storytelling','Product Campaigns','Cinematic Photography','AI UGC','Hypermotion Video','Digital Billboards'].forEach(s => { %>
                    <span class="tag-badge"><%= s %></span>
                  <% }) %>
                </div>
              </div>

              <div class="skill-box">
                <div class="skill-box-label">Finance &amp; Trading</div>
                <div class="skill-tags">
                  <% ['Algorithmic Trading','Quantitative Investing','Client Advisory','FinTech','Systematic Strategies'].forEach(s => { %>
                    <span class="tag-badge purple"><%= s %></span>
                  <% }) %>
                </div>
              </div>

              <div class="skill-box">
                <div class="skill-box-label">Operations &amp; Engineering</div>
                <div class="skill-tags">
                  <% ['Production Engineering','Vendor Development','NPD','Procurement','Quality Management'].forEach(s => { %>
                    <span class="tag-badge"><%= s %></span>
                  <% }) %>
                </div>
              </div>

              <div class="skill-box">
                <div class="skill-box-label">Strategy &amp; Tools</div>
                <div class="skill-tags">
                  <% ['Creative Strategy','Brand Storytelling','Campaign Planning','AI Tools','D2C Marketing'].forEach(s => { %>
                    <span class="tag-badge purple"><%= s %></span>
                  <% }) %>
                </div>
              </div>
            </div>

            <!-- EXPERIENCE -->
            <div class="tab-pane fade" id="tab-experience">
              <div class="exp-header"><i class="bi bi-briefcase-fill me-1"></i> EXPERIENCE</div>
              <div class="timeline">
                <% data.experience.forEach(exp => { %>
                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="exp-card">
                    <div class="exp-title"><%= exp.title %> <span class="text-muted fw-normal" style="font-size:0.82rem">· <%= exp.type %></span></div>
                    <div class="exp-company"><%= exp.company %></div>
                    <div class="exp-meta"><i class="bi bi-calendar3 me-1"></i><%= exp.period %> &nbsp;·&nbsp; <%= exp.location %></div>
                    <ul class="exp-points">
                      <% exp.points.forEach(pt => { %><li><%= pt %></li><% }) %>
                    </ul>
                    <div class="skill-tags">
                      <% exp.skills.forEach(sk => { %>
                        <span class="tag-badge small"><%= sk %></span>
                      <% }) %>
                    </div>
                  </div>
                </div>
                <% }) %>
              </div>
            </div>

            <!-- EDUCATION -->
            <div class="tab-pane fade" id="tab-education">
              <div class="exp-header"><i class="bi bi-mortarboard-fill me-1"></i> EDUCATION</div>
              <% data.education.forEach(edu => { %>
              <div class="edu-card">
                <div class="edu-institution"><%= edu.institution %></div>
                <div class="edu-degree"><%= edu.degree %></div>
                <div class="edu-meta"><i class="bi bi-calendar3 me-1"></i><%= edu.period %> &nbsp;·&nbsp; Grade: <%= edu.grade %></div>
              </div>
              <% }) %>
            </div>

            <!-- AWARDS -->
            <div class="tab-pane fade" id="tab-awards">
              <div class="exp-header"><i class="bi bi-trophy-fill me-1"></i> AWARDS</div>
              <% if (data.awards.length === 0) { %>
                <div class="coming-soon"><i class="bi bi-trophy"></i><p>Coming Soon</p></div>
              <% } %>
            </div>

            <!-- CERTIFICATIONS -->
            <div class="tab-pane fade" id="tab-certs">
              <div class="exp-header"><i class="bi bi-patch-check-fill me-1"></i> CERTIFICATIONS</div>
              <% if (data.certifications.length === 0) { %>
                <div class="coming-soon"><i class="bi bi-patch-check"></i><p>Coming Soon</p></div>
              <% } %>
            </div>

          </div><!-- /tab-content -->
        </div>

        <!-- Right: always shows Experience timeline when Who I Am tab active; hides on other tabs -->
        <div class="col-lg-7" id="expSidePanel">
          <div class="exp-header"><i class="bi bi-briefcase-fill me-1"></i> EXPERIENCE</div>
          <div class="timeline">
            <% data.experience.forEach(exp => { %>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="exp-card">
                <div class="exp-title"><%= exp.title %> <span class="text-muted fw-normal" style="font-size:0.82rem">· <%= exp.type %></span></div>
                <div class="exp-company"><%= exp.company %></div>
                <div class="exp-meta"><i class="bi bi-calendar3 me-1"></i><%= exp.period %> &nbsp;·&nbsp; <%= exp.location %></div>
                <ul class="exp-points">
                  <% exp.points.forEach(pt => { %><li><%= pt %></li><% }) %>
                </ul>
                <div class="skill-tags">
                  <% exp.skills.forEach(sk => { %>
                    <span class="tag-badge small"><%= sk %></span>
                  <% }) %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== PROJECTS ==================== -->
  <section id="projects" class="section-padding">
    <div class="container">
      <p class="section-eyebrow text-center">OUR PROJECTS</p>
      <h2 class="section-title text-center">Creative <span class="accent">Work</span></h2>
      <p class="section-subtitle text-center mb-5">AI-powered campaigns, visuals &amp; videos for D2C brands</p>

      <!-- Featured Bento Grid -->
      <div class="featured-grid mb-5">
        <!-- Featured large video -->
        <div class="featured-main" onclick="openLightbox('<%= data.media.featured.url %>', '<%= data.media.featured.isVideo ? "video" : "image" %>')">
          <% if (data.media.featured.isVideo) { %>
          <video class="featured-media" autoplay muted loop playsinline poster="<%= data.media.featured.thumb %>">
            <source src="<%= data.media.featured.url %>" type="video/mp4" />
          </video>
          <% } else { %>
          <img class="featured-media" src="<%= data.media.featured.url %>" alt="<%= data.media.featured.brief %>" />
          <% } %>
          <div class="featured-overlay">
            <span class="featured-cat-badge"><%= data.media.featured.category %></span>
            <div class="featured-info">
              <div class="featured-brand"><%= data.media.featured.brand %></div>
              <div class="featured-brief"><%= data.media.featured.brief %></div>
            </div>
          </div>
        </div>

        <!-- Side items -->
        <div class="featured-side">
          <% data.media.featuredSide.forEach(item => { %>
          <div class="featured-side-item" onclick="openLightbox('<%= item.url %>', '<%= item.isVideo ? "video" : "image" %>')">
            <img src="<%= item.thumb %>" alt="<%= item.brief %>" loading="lazy" />
            <% if (item.isVideo) { %>
              <div class="play-icon"><i class="bi bi-play-fill"></i></div>
            <% } %>
            <div class="side-overlay">
              <span class="side-cat"><%= item.category %></span>
              <span class="side-brief"><%= item.brief %></span>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Category Grid -->
      <div class="row g-4">
        <% data.media.categories.forEach(cat => { %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="cat-card" data-cat="<%= cat.name %>">
            <div class="cat-thumbs">
              <% cat.items.slice(0,4).forEach(item => { %>
                <div class="cat-thumb">
                  <img src="<%= item.thumbSm || item.thumb %>" alt="<%= item.brief %>" loading="lazy" />
                  <% if (item.isVideo) { %><div class="cat-play"><i class="bi bi-play-fill"></i></div><% } %>
                </div>
              <% }) %>
            </div>
            <div class="cat-info">
              <span class="cat-label">CATEGORY</span>
              <h6 class="cat-name"><%= cat.name %></h6>
              <span class="cat-count"><%= cat.items.length %> piece<%= cat.items.length !== 1 ? 's' : '' %></span>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox-overlay" onclick="closeLightbox()">
    <div class="lightbox-content" onclick="event.stopPropagation()">
      <button class="lightbox-close" onclick="closeLightbox()"><i class="bi bi-x-lg"></i></button>
      <div id="lightboxMedia"></div>
    </div>
  </div>

  <!-- Category Modal -->
  <div id="catModal" class="lightbox-overlay" onclick="closeCatModal()">
    <div class="cat-modal-content" onclick="event.stopPropagation()">
      <div class="cat-modal-header">
        <h5 id="catModalTitle"></h5>
        <button class="lightbox-close" onclick="closeCatModal()"><i class="bi bi-x-lg"></i></button>
      </div>
      <div id="catModalGrid" class="cat-modal-grid"></div>
    </div>
  </div>

  <!-- ==================== CONTACT ==================== -->
  <section id="contact" class="section-padding section-alt">
    <div class="container">
      <p class="section-eyebrow text-center">LET'S CONNECT</p>
      <h2 class="section-title text-center">Contact <span class="accent">Me</span></h2>
      <p class="section-subtitle text-center mb-5">Have a project in mind? Let's talk.</p>

      <div class="row g-4 justify-content-center">

        <!-- Left: Contact Info -->
        <div class="col-lg-4">
          <div class="contact-info-card">
            <div class="contact-icon-wrap"><i class="bi bi-envelope-fill"></i></div>
            <div>
              <div class="contact-info-label">Email</div>
              <div class="contact-info-value"><a href="mailto:<%= data.email %>"><%= data.email %></a></div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="contact-icon-wrap"><i class="bi bi-geo-alt-fill"></i></div>
            <div>
              <div class="contact-info-label">Location</div>
              <div class="contact-info-value"><%= data.location %></div>
            </div>
          </div>

          <div class="d-flex gap-2 mt-3 flex-wrap">
            <% if (data.social.linkedin) { %>
              <a href="<%= data.social.linkedin %>" target="_blank" class="social-btn"><i class="bi bi-linkedin"></i> LinkedIn</a>
            <% } %>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="col-lg-7">
          <div class="contact-form-wrap">
            <form id="contactForm" class="contact-form">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Your Name <span class="req">*</span></label>
                  <input type="text" class="form-control" name="name" placeholder="Jane Smith" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label">Email Address <span class="req">*</span></label>
                  <input type="email" class="form-control" name="email" placeholder="jane@example.com" required />
                </div>
              </div>
              <div class="mb-4">
                <label class="form-label">Message <span class="req">*</span></label>
                <textarea class="form-control" name="message" rows="6" placeholder="Tell me about your project..." required></textarea>
              </div>
              <button type="submit" class="btn-send">
                <span class="btn-text"><i class="bi bi-send-fill"></i> Send Message</span>
                <span class="btn-loading d-none"><span class="spinner-border spinner-border-sm"></span> Sending...</span>
              </button>
              <div id="formMsg" class="mt-3 d-none"></div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container text-center">
      <p class="text-muted small mb-0">
        <span class="text-white"><%= data.name %> &nbsp;|&nbsp; <%= data.role %></span>
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    window.__catItems = <%- JSON.stringify(data.media.categories.reduce((acc, c) => {
      acc[c.name] = c.items.map(i => ({
        type: i.isVideo ? 'video' : 'image',
        videoUrl: i.url,
        url: i.url,
        thumb: i.thumb,
        brand: i.brand,
        brief: i.brief
      }));
      return acc;
    }, {})) %>;
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
